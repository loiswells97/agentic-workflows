{
    "permissions": {
        "defaultMode": "auto",
        "deny": [
            "Bash(git push --force *)",
            "Bash(git reset --hard *)",
            "Bash(git clean *)",
            "Bash(rm -rf *)",
            "Bash(npm publish *)",
            "Bash(docker system prune *)",
            "Read(./.env)",
            "Read(./.env.*)",
            "Edit(.claude/settings.json)",
            "Write(.claude/settings.json)"
        ],
        "allow": ["WebSearch", "WebFetch"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git commit *)",
                        "command": "branch=$(git branch --show-current 2>/dev/null); if [ \"$branch\" = \"main\" ]; then echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"Blocked: cannot git commit directly to main branch\"}}'; fi",
                        "statusMessage": "Checking branch before commit..."
                    }
                ]
            }
        ]
    }
}
